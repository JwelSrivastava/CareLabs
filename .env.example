# Copy to .env and replace every value before running locally.
APP_NAME=CareLabs
APP_ENV=local

POSTGRES_USER=carelabs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=carelabs
POSTGRES_PORT=5432

# Used by tools on the host, including pytest and a local Uvicorn process.
# Docker Compose points the API container at the postgres service instead.
# Keep the user, password, database, and port aligned with the values above.
# Avoid @ : / # in the password so the URL stays valid.
DATABASE_URL=postgresql+psycopg://carelabs:change-me@localhost:5432/carelabs

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Host port for the API container. Optional.
API_PORT=8000

# Used only by: python -m app.scripts.create_admin
# Replace the password. The script rejects the placeholder below.
ADMIN_NAME=CareLabs Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
